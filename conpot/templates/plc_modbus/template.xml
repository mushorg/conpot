<core>
    <template>
        <entity name="unit">plc_modbus</entity>
        <entity name="vendor">Conpot</entity>
        <entity name="description">Modbus slave whose coils and registers are driven by a PLC scan cycle</entity>
        <entity name="protocols">modbus</entity>
        <entity name="creator">the conpot team</entity>
    </template>
    <databus>
        <key_value_mappings>
            <!-- Coil [0] start, coil [1] stop. Written by Modbus clients, sampled each scan. -->
            <key name="memoryModbusSlave1BlockA">
                <value type="value">[0 for b in range(0,8)]</value>
            </key>
            <!-- Discrete [0] running bit written by the scan cycle. -->
            <key name="memoryModbusSlave1BlockB">
                <value type="value">[0 for b in range(0,8)]</value>
            </key>
            <!-- Analog [0] derived process value (holding[0] * 10). -->
            <key name="memoryModbusSlave1BlockC">
                <value type="value">[0 for b in range(0,8)]</value>
            </key>
            <!-- Holding [0] increments while running (16-bit wrap). -->
            <key name="memoryModbusSlave1BlockD">
                <value type="value">[0 for b in range(0,8)]</value>
            </key>
            <key name="plc_scan">
                <value type="function" param="[50, 'native', 'memoryModbusSlave1BlockA', 'memoryModbusSlave1BlockB', 'memoryModbusSlave1BlockD', 'memoryModbusSlave1BlockC']">conpot.emulators.plc.scan_cycle.PlcScanCycle</value>
            </key>
        </key_value_mappings>
    </databus>
</core>
